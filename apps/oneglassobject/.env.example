# One Glass Object — 环境变量清单（模板，可进 git）

# ── Supabase（新建的那个项目，不要用 onesilkribbon 的）────────────
# 在 Supabase 后台 → Project Settings → API 里能找到这三个值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — 服务端专用，绝不能加 NEXT_PUBLIC_ 前缀，绝不能出现在客户端代码里
SUPABASE_SERVICE_KEY=

# ── Stripe ────────────────────────────────────────────────
# 可以沿用现在的 Stripe 账号，但 webhook 要为新域名单独建一个端点，
# 所以 STRIPE_WEBHOOK_SECRET 一定是新的，不能直接抄老站的
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ── AfterShip（物流追踪，可选）───────────────────────────────
# 留空时 /api/tracking 会自动降级成只显示订单自身状态，不影响其他功能
AFTERSHIP_API_KEY=

# ── 邮件（Resend）─────────────────────────────────────────
# 新域名要在 Resend 里单独验证一次，验证通过前发信会失败
RESEND_API_KEY=
EMAIL_FROM=hello@oneglassobject.com

# ── 站点 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── 后台管理员 ────────────────────────────────────────────
# 逗号分隔的邮箱列表，要和新库 schema.sql 里 is_admin_user() 的邮箱保持一致
ADMIN_EMAILS=

# ── Sentry（错误监控，可选但强烈建议配置）───────────────────
# 必须是新站自己的 Sentry 项目，否则新站的报错会跑到 onesilkribbon 的项目里
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
