# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — 服务端专用，绝不能加 NEXT_PUBLIC_ 前缀，绝不能出现在客户端代码里
SUPABASE_SERVICE_KEY=

# ── Stripe ────────────────────────────────────────────────
# 当前结账走的是 Stripe Checkout（整页跳转），不需要 publishable key / Stripe Elements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ── AfterShip（物流追踪，可选）───────────────────────────────
# 留空时 /api/tracking 会自动降级成只显示订单自身状态，不影响其他功能
AFTERSHIP_API_KEY=

# ── 邮件（Resend）─────────────────────────────────────────
RESEND_API_KEY=
# 发件地址，留空则代码里回退成 song@onesilkribbon.com
EMAIL_FROM=song@onesilkribbon.com

# ── 站点 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 后台管理员 ────────────────────────────────────────────
# 逗号分隔的邮箱列表，同时要在 Supabase 的 is_admin_user() 函数里保持一致
# （supabase/schema.sql 里那段 RLS 策略）
ADMIN_EMAILS=

# ── Sentry（错误监控，可选但强烈建议配置）───────────────────
# 不配置的话 sentry.*.config.js 会静默不生效，线上报错完全收不到告警
NEXT_PUBLIC_SENTRY_DSN=
# 上传 source map 用的 Sentry 组织/项目名。留空则回退成 onesilkribbon；
# 新开站点时必须各自填写，否则新站的报错会上报到老站的 Sentry 项目里
SENTRY_ORG=
SENTRY_PROJECT=
